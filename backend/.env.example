# ── Database ──────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/clinicbrain
SPRING_DATASOURCE_USERNAME=cb_user
SPRING_DATASOURCE_PASSWORD=change_me

# ── Redis (cache) ─────────────────────────────────────────────────────────────
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
APP_SECURITY_JWT_SECRET=replace-with-base64-encoded-256-bit-secret
APP_SECURITY_JWT_EXPIRATION_MS=86400000

# ── AI (Groq) ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_replace_with_your_groq_api_key

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
SPRING_PROFILES_ACTIVE=local
